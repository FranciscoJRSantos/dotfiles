/.agent-shell/

# fish universal variables are machine-local mutable state, not portable config
fish/.config/fish/fish_variables

# Fisher-managed plugin files and generated completions; fish_plugins is the manifest
fish/.config/fish/functions/
fish/.config/fish/conf.d/
fish/.config/fish/completions/

# hyprwhspr installs this Noctalia theme template at runtime
noctalia/.config/noctalia/templates/

# Noctalia renders these from its current palette (built-in "emacs" and
# "ghostty" templates); they are regenerated whenever the scheme changes
doom/.config/doom/themes/noctalia-theme.el
ghostty/.config/ghostty/themes/noctalia
