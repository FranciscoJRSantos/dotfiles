[user]
	name = Francisco Santos
	email = franciscojrsantos1997@gmail.com
	username = FranciscoJRSantos
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDXX+utM8d3LSGozsyeYxATzaOLLQpMJvGtnlbEJppS7
[core]
	editor = nvim
[init]
	defaultBranch = main
[github]
	user = FranciscoJRSantos
[gitlab]
	user = FranciscoJRSantos
[fetch]
	prune = true
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[rebase]
	autoSquash = true
	updateRefs = true
[merge]
	conflictStyle = zdiff3
[diff]
	algorithm = histogram
[rerere]
	enabled = true
[commit]
	verbose = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# [gpg]
#   format = ssh
# 
# [gpg "ssh"]
#   program = "/opt/1Password/op-ssh-sign"
# 
# [commit]
#   gpgsign = true

[includeIf "gitdir:~/Documents/projects/**"]
  path = ~/Documents/projects/.gitconfig

[includeIf "gitdir:~/Documents/projects/AIH/**"]
  path = ~/Documents/projects/AIH/.gitconfig
