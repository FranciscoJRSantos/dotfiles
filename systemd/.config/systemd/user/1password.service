[Unit]
Description=1Password
Documentation=https://support.1password.com/linux-upgrade/
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=exec
# Same invocation as the app's own XDG autostart entry: tray only, no window.
ExecStart=/usr/bin/1password --silent
# Electron may fork; tie the unit's lifetime to the whole process group.
ExitType=cgroup
# Restart after a crash, but stay quit when it is closed from the tray.
Restart=on-failure
RestartSec=3

[Install]
WantedBy=hyprland-session.target
