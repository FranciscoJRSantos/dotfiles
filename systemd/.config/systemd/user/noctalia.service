[Unit]
Description=Noctalia shell
Documentation=https://docs.noctalia.dev
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# Noctalia 5.4.1 does not implement sd_notify, so Type=notify would block the
# start until it times out. It also stays in the foreground without --daemon.
Type=simple
ExecStart=/usr/bin/noctalia
# Always, not on-failure: during the 2026-11-05 incident it exited cleanly and
# nothing brought it back.
Restart=always
RestartSec=3

[Install]
WantedBy=hyprland-session.target
